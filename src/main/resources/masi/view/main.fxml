<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<!--
    main.fxml — Vue principale (ch. JavaFX slide 30-32)
    Associé au contrôleur masi.app.MainController via fx:controller.
    Layout : BorderPane principal
      TOP    → barre d'outils (palette + boutons actions)
      CENTER → zone de dessin (Pane)
      RIGHT  → panneau propriétés (stratégie log, PCC)
      BOTTOM → barre de statut + log
      LEFT   → liste des dessins sauvegardés
-->
<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="masi.app.MainController"
            prefWidth="1100" prefHeight="700">

    <!-- ══════════════════════════════════════════════════════════
         TOP — Barre d'outils principale
    ══════════════════════════════════════════════════════════ -->
    <top>
        <VBox spacing="0">
            <!-- Palette de formes + actions dessin -->
            <ToolBar style="-fx-background-color: #f0f0f0; -fx-border-color: #cccccc; -fx-border-width: 0 0 1 0;">
                <Label text="Forme :" style="-fx-font-weight: bold;"/>

                <ToggleButton fx:id="btnRectangle" text="▭ Rectangle"
                              onAction="#selectionnerRectangle"
                              style="-fx-background-color: #e8f4fd;"/>
                <ToggleButton fx:id="btnCercle" text="○ Cercle"
                              onAction="#selectionnerCercle"
                              style="-fx-background-color: #e8f4fd;"/>
                <ToggleButton fx:id="btnLigne" text="╱ Ligne"
                              onAction="#selectionnerLigne"
                              style="-fx-background-color: #e8f4fd;"/>

                <Separator/>

                <Label text="Couleur :"/>
                <ColorPicker fx:id="colorPicker"/>

                <Separator/>

                <Button fx:id="btnUndo" text="↩ Annuler"
                        onAction="#annuler"
                        style="-fx-background-color: #fff3cd;"
                        disable="true"/>
                <Button fx:id="btnRedo" text="↪ Rétablir"
                        onAction="#retablir"
                        style="-fx-background-color: #fff3cd;"
                        disable="true"/>
                <Button fx:id="btnSupprimer" text="✕ Effacer forme"
                        onAction="#effacerForme"
                        style="-fx-background-color: #f8d7da;"/>

                <Separator/>

                <TextField fx:id="txtNomDessin" promptText="Nom du dessin" prefWidth="160"/>
                <Button fx:id="btnSauvegarder" text="💾 Sauvegarder"
                        onAction="#sauvegarderDessin"
                        style="-fx-background-color: #d4edda;"/>
            </ToolBar>
        </VBox>
    </top>

    <!-- ══════════════════════════════════════════════════════════
         LEFT — Liste des dessins sauvegardés
    ══════════════════════════════════════════════════════════ -->
    <left>
        <VBox spacing="8" prefWidth="200">
            <padding><Insets top="8" left="8" right="8" bottom="8"/></padding>

            <Label text="Dessins sauvegardés" style="-fx-font-weight: bold;"/>
            <ListView fx:id="listeDessins" prefHeight="200"/>
            <Button fx:id="btnOuvrir" text="📂 Ouvrir"
                    onAction="#ouvrirDessin"
                    maxWidth="Infinity"
                    style="-fx-background-color: #cce5ff;"/>

            <Separator/>

            <!-- Stratégie de journalisation (Strategy ch.06) -->
            <Label text="Stratégie de log" style="-fx-font-weight: bold;"/>
            <ComboBox fx:id="cbLogStrategy" maxWidth="Infinity"/>

            <Separator/>

            <!-- Module graphe + PCC (Strategy ch.06 — optionnel) -->
            <Label text="Graphe — Plus court chemin" style="-fx-font-weight: bold;"/>

            <!-- Ajouter un nœud -->
            <HBox spacing="4">
                <TextField fx:id="txtNomNoeud" promptText="Nom du nœud" HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnAjouterNoeud" text="+ Nœud"
                        onAction="#ajouterNoeud"/>
            </HBox>

            <!-- Ajouter une arête -->
            <Label text="Arête :"/>
            <HBox spacing="4" alignment="CENTER_LEFT">
                <ComboBox fx:id="cbAreteSource"  promptText="Source"  prefWidth="68"/>
                <TextField fx:id="txtPoids" promptText="Poids" prefWidth="44"/>
                <ComboBox fx:id="cbAreteDest"    promptText="Dest"    prefWidth="68"/>
            </HBox>
            <Button fx:id="btnAjouterArete" text="+ Arête"
                    onAction="#ajouterArete"
                    maxWidth="Infinity"
                    style="-fx-background-color: #e2d9f3;"/>

            <Separator/>

            <!-- Calcul du PCC -->
            <Label text="Algorithme :"/>
            <ComboBox fx:id="cbAlgorithme" maxWidth="Infinity"/>
            <Label text="Départ :"/>
            <ComboBox fx:id="cbNoeudDepart" maxWidth="Infinity"/>
            <Label text="Arrivée :"/>
            <ComboBox fx:id="cbNoeudArrivee" maxWidth="Infinity"/>
            <Button fx:id="btnCalculerPCC" text="⚡ Calculer PCC"
                    onAction="#calculerPCC"
                    maxWidth="Infinity"
                    style="-fx-background-color: #fff3cd;"/>
            <Button fx:id="btnViderGraphe" text="🗑 Vider graphe"
                    onAction="#viderGraphe"
                    maxWidth="Infinity"
                    style="-fx-background-color: #f8d7da;"/>
        </VBox>
    </left>

    <!-- ══════════════════════════════════════════════════════════
         CENTER — Zone de dessin (Pane JavaFX)
    ══════════════════════════════════════════════════════════ -->
    <center>
        <Pane fx:id="zoneDessin"
              style="-fx-background-color: white; -fx-border-color: #aaaaaa; -fx-border-width: 1;"
              BorderPane.alignment="CENTER"/>
    </center>

    <!-- ══════════════════════════════════════════════════════════
         BOTTOM — Barre de statut + zone de log
    ══════════════════════════════════════════════════════════ -->
    <bottom>
        <VBox spacing="0">
            <Label fx:id="lblStatus" text="Prêt."
                   style="-fx-padding: 4 8; -fx-background-color: #f8f9fa; -fx-border-color: #dee2e6; -fx-border-width: 1 0 0 0;"/>
            <TitledPane text="Journal d'activité" expanded="false">
                <TextArea fx:id="txtLog"
                          prefHeight="100"
                          editable="false"
                          wrapText="true"
                          style="-fx-font-family: monospace; -fx-font-size: 11;"/>
            </TitledPane>
        </VBox>
    </bottom>

</BorderPane>
